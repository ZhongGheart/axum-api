# ============================================
# 应用基础配置
# ============================================
# 服务器监听地址与端口
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ============================================
# 数据库配置
# ============================================
# PostgreSQL 连接字符串格式:
#   postgres://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgres://postgres:password@localhost:5432/axum_api

# ============================================
# JWT 配置
# ============================================
# JWT 密钥（生产环境请使用足够长的随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# JWT 过期时间（单位：秒，默认7天）
JWT_EXPIRATION_SECONDS=604800

# ============================================
# CORS 配置
# ============================================
# 允许的跨域来源（逗号分隔，* 表示允许所有）
CORS_ALLOWED_ORIGINS=*
