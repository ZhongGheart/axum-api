# ============================================
# 应用基础配置
# ============================================
# 服务器监听地址与端口
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ============================================
# 数据库配置
# ============================================
# PostgreSQL 连接字符串格式:
#   postgres://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgres://postgres:password@localhost:5432/axum_api

# ============================================
# JWT 配置
# ============================================
# JWT 密钥（生产环境请使用足够长的随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# JWT 过期时间（单位：秒，默认7天）
JWT_EXPIRATION_SECONDS=604800

# ============================================
# CORS 配置
# ============================================
# 允许的跨域来源（逗号分隔，* 表示允许所有）
CORS_ALLOWED_ORIGINS=*

# ============================================
# Redis 配置
# ============================================
# Redis 连接字符串（支持单机/哨兵/集群）
REDIS_URL=redis://127.0.0.1:6379

# ============================================
# 数据库连接池配置
# ============================================
# 最大连接数
DB_POOL_MAX_SIZE=20
# 连接超时（秒）
DB_CONNECT_TIMEOUT=10

# ============================================
# 接口限流配置
# ============================================
# 单个 IP 每分钟最大请求数
RATE_LIMIT_IP_MAX=100
# IP 限流时间窗口（秒）
RATE_LIMIT_IP_WINDOW=60
# 单个用户每分钟最大请求数（需登录）
RATE_LIMIT_USER_MAX=30
# 用户限流时间窗口（秒）
RATE_LIMIT_USER_WINDOW=60
