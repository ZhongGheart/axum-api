# ============================================
# 应用基础配置
# ============================================
# 运行环境：development / production
# production 下会拒绝通配符 CORS 与占位密钥
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ============================================
# 数据库配置
# ============================================
DATABASE_URL=postgres://postgres:password@localhost:5432/axum_api

# docker compose 使用的数据库密码（必填，无默认值）
DB_PASSWORD=change-me-strong-db-password

# 启动时自动执行迁移（关闭后需自行运行 sqlx migrate run）
MIGRATE_ON_STARTUP=true

# ============================================
# 数据库读写分离配置（V9 新增）
# ============================================
# 读库连接串（可选，留空则使用主库）
DATABASE_READ_URL=
# 读库连接池大小
DB_READ_POOL_MAX_SIZE=30

# ============================================
# JWT 配置
# ============================================
# 必填：至少 32 字符。生成方式：openssl rand -base64 48
# 生产环境（APP_ENV=production）会拒绝示例占位值
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION_SECONDS=604800

# ============================================
# CORS 配置
# ============================================
# 允许的跨域来源，逗号分隔。生产环境禁止使用 *
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# Redis 配置（必需：限流、令牌注销、登录锁定均依赖）
# ============================================
REDIS_URL=redis://127.0.0.1:6379

# ============================================
# 数据库连接池配置
# ============================================
DB_POOL_MAX_SIZE=20
DB_CONNECT_TIMEOUT=10

# ============================================
# 接口限流配置
# ============================================
RATE_LIMIT_IP_MAX=100
RATE_LIMIT_IP_WINDOW=60
RATE_LIMIT_USER_MAX=30
RATE_LIMIT_USER_WINDOW=60

# ============================================
# 安全策略配置（v0.2 新增）
# ============================================
# 是否信任上游代理的 X-Forwarded-For / X-Real-IP。
# 仅当本服务确实部署在可信反向代理之后才可置为 true，
# 否则客户端可伪造该头绕过限流与登录锁定。
TRUST_PROXY_HEADERS=false
# 登录失败锁定阈值（账号与 IP 各自独立计数）
LOGIN_MAX_FAILURES=10
# 登录失败计数窗口（秒）
LOGIN_FAILURE_WINDOW=300
