# ============================================
# 应用基础配置
# ============================================
# 运行环境：development / production
# production 下会拒绝通配符 CORS 与占位密钥
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ============================================
# 数据库配置
# ============================================
DATABASE_URL=postgres://postgres:password@localhost:5432/axum_api

# docker compose 使用的数据库密码（必填，无默认值）
DB_PASSWORD=change-me-strong-db-password

# 启动时自动执行迁移（关闭后需自行运行 sqlx migrate run）
MIGRATE_ON_STARTUP=true

# ============================================
# 数据库读写分离配置（V9 新增）
# ============================================
# 读库连接串（可选，留空则使用主库）
DATABASE_READ_URL=
# 读库连接池大小
DB_READ_POOL_MAX_SIZE=30

# ============================================
# JWT 配置
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION_SECONDS=604800

# ============================================
# CORS 配置
# ============================================
CORS_ALLOWED_ORIGINS=*

# ============================================
# Redis 配置
# ============================================
REDIS_URL=redis://127.0.0.1:6379

# ============================================
# 数据库连接池配置
# ============================================
DB_POOL_MAX_SIZE=20
DB_CONNECT_TIMEOUT=10

# ============================================
# 接口限流配置
# ============================================
RATE_LIMIT_IP_MAX=100
RATE_LIMIT_IP_WINDOW=60
RATE_LIMIT_USER_MAX=30
RATE_LIMIT_USER_WINDOW=60

# ============================================
# RSA 非对称加密配置（V9 新增）
# ============================================
# 是否启用请求加密
CRYPTO_ENABLED=true
# RSA 私钥（PEM 格式，留空则自动生成开发用密钥）
RSA_PRIVATE_KEY=
# RSA 公钥（PEM 格式，留空则自动生成）
RSA_PUBLIC_KEY=
# 需要强制加密的接口路径（逗号分隔）
CRYPTO_ENFORCED_PATHS=/api/auth/login,/api/auth/register

# ============================================
# 验证码配置（V9 新增）
# ============================================
CAPTCHA_ENABLED=true

# ============================================
# 应用密钥（V9 新增，验证码/加密辅助）
# ============================================
APP_SECRET=change-this-to-a-random-secret
